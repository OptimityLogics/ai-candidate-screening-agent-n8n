      "id": "740638bc-a1f7-49f4-8c3e-4a7290a48c27",
      "name": "Get Job Details",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1760,
        944
      ],
      "alwaysOutputData": true,
      "notesInFlow": true,
      "notes": "Looks up Job Title, Job Description and Required Experience from the 'Jobs' tab using the job_id from the application link."
    },
    {
      "parameters": {
        "jsCode": "const form = $('Candidate Application Form').first().json ?? {};\nconst ext = $('Extract Resume Text from PDF').first().json ?? {};\nconst job = $('Get Job Details').first().json ?? {};\n\nconst resumeText = ext.text ?? ext.extractedText ?? ext.data ?? '';\nconst jobId = String(form.job_id ?? form['Job ID'] ?? '').trim();\n\nif (!job['Job ID']) {\n  throw new Error(`Job ID \"${jobId}\" was not found in the Jobs tab. Check the application link (?job_id=...) and the Jobs sheet.`);\n}\nif (String(job['Status'] ?? 'Open').trim().toLowerCase() !== 'open') {\n  throw new Error(`Job ${jobId} is not Open in the Jobs tab (Status = ${job['Status']}).`);\n}\nif (!String(resumeText).trim()) {\n  throw new Error('No text was extracted from the PDF. Check the uploaded PDF and the Extract From File binary property name. Scanned PDFs may require OCR.');\n}\n\nconst jobTitle = job['Job Title'] ?? '';\nconst jobDescription = job['Job Description'] ?? '';\nconst requiredExperience = job['Required Experience'] || 'Not specified';\n\nconst candidateName = String(form['Full Name'] ?? '').trim();\nconst candidateEmail = String(form['Email'] ?? '').trim();\nconst candidatePhone = String(form['Phone'] ?? '').trim();\n\nconst prompt = `You are a careful recruitment screening assistant. Analyze only job-related evidence. Do not use or infer age, gender, race, religion, disability, nationality, photo, family status, or any other protected/personal characteristic. Do not make a hiring decision or automatically reject a candidate. Do not invent missing facts. If the resume does not demonstrate a requirement, label it as \"not demonstrated\" rather than claiming the candidate lacks the skill. Return ONLY valid JSON matching the requested structure.\n\nJOB TITLE: ${jobTitle}\nREQUIRED EXPERIENCE: ${requiredExperience}\nJOB DESCRIPTION:\n${jobDescription}\n\nRESUME TEXT:\n${String(resumeText).slice(0, 45000)}\n\nReturn this JSON structure:\n{\n  \"candidate_profile\": {\n    \"full_name\": string|null, \"email\": string|null, \"phone\": string|null, \"skills\": string[], \"experience_summary\": string, \"estimated_relevant_experience_years\": number|null, \"education\": string[], \"projects\": string[]\n  },\n  \"requirements_analysis\": {\n    \"matching_skills\": [{\"skill\": string, \"resume_evidence\": string}],\n    \"not_demonstrated_or_unverified\": [{\"requirement\": string, \"reason\": string}],\n    \"experience_evidence\": string, \"project_evidence\": string, \"certification_evidence\": string, \"certifications_applicable\": boolean,\n    \"skill_score\": number, \"experience_score\": number, \"project_score\": number, \"certification_score\": number\n  },\n  \"review_summary\": string, \"questions_for_recruiter\": string[]\n}\nScores must be numbers from 0 to 100 and based on evidence in the resume versus the job-related requirements. Do not score protected characteristics. If certifications are not required in the job description, set certifications_applicable to false. The scores are decision-support estimates, not a final hiring recommendation.`;\n\nreturn [{ json: { jobId, jobTitle, jobDescription, requiredExperience, candidateName, candidateEmail, candidatePhone, resumeText: String(resumeText), prompt } }];"
      },
      "id": "41104607-8d04-4e07-9b9d-f8c53f881478",
      "name": "Prepare Screening Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        944
      ]
