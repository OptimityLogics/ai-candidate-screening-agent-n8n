      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        2192,
        944
      ],
      "id": "3566f289-9345-4b7c-830d-ec94825f5e90",
      "name": "Message a model",
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst source = $('Prepare Screening Prompt').first().json;\n\nconst gParts = item?.candidates?.[0]?.content?.parts ?? item?.content?.parts ?? [];\nlet raw = gParts.filter(p => !p.thought).map(p => p.text ?? '').join('\\n');\nif (!raw && typeof item?.text === 'string') raw = item.text;\nif (!raw) throw new Error('Gemini returned no text. keys: ' + Object.keys(item ?? {}).join(','));\n\nraw = raw.trim().replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/\\s*```$/, '');\n\nlet analysis;\ntry { analysis = JSON.parse(raw); }\ncatch (e) { throw new Error('Could not parse Gemini JSON response. Details: ' + e.message); }\n\nconst profile = analysis.candidate_profile ?? {};\nconst a = analysis.requirements_analysis ?? {};\nconst clamp = n => Math.max(0, Math.min(100, Number(n) || 0));\n\n// ---- transparent weighted score ----\nconst parts = [\n  { key: 'skill_score', weight: 0.50 },\n  { key: 'experience_score', weight: 0.25 },\n  { key: 'project_score', weight: 0.15 },\n  { key: 'certification_score', weight: 0.10 }\n].filter(x => x.key !== 'certification_score' || a.certifications_applicable !== false);\n\nconst weightTotal = parts.reduce((s, x) => s + x.weight, 0);\nconst matchScore = Math.round(parts.reduce((s, x) => s + clamp(a[x.key]) * x.weight, 0) / (weightTotal || 1));\nconst reviewStatus = matchScore >= 75 ? 'Priority Review' : matchScore >= 50 ? 'Standard Review' : 'Further Review';\n\n// ---- candidate experience (years) ----\nlet candidateYears = profile.estimated_relevant_experience_years ?? a.candidate_experience_years ?? a.experience_years ?? profile.total_experience_years ?? profile.experience_years ?? '';\nif (candidateYears === '' || candidateYears === null) {\n  const m = String(profile.experience_summary ?? '').match(/(\\d+(?:\\.\\d+)?)\\s*(?:\\+)?\\s*(?:years?|yrs?)/i);\n  candidateYears = m ? Number(m[1]) : '';\n}\n\n// ---- resume file name ----\nlet resumeFileName = '';\ntry {\n  const bin = $('Candidate Application Form').first().binary ?? {};\n  const firstKey = Object.keys(bin)[0];\n  resumeFileName = firstKey ? (bin[firstKey].fileName ?? '') : '';\n} catch (e) {}\n\nconst submittedAt = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' });\nconst applicationId = 'APP-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 5).toUpperCase();\n\nconst missing = (a.not_demonstrated_or_unverified ?? []).map(x => `${x.requirement}: ${x.reason}`).join(' | ');\nconst matching = (a.matching_skills ?? []).map(x => x.skill).join(', ');\nconst questions = (analysis.questions_for_recruiter ?? []).join(' | ');\nconst certScore = a.certifications_applicable === false ? 'N/A' : clamp(a.certification_score);\nconst skills = (profile.skills ?? []).join(', ');\n\n// candidate-entered details are more reliable than AI-extracted ones\nconst candidateName = source.candidateName || profile.full_name || 'Not provided';\nconst candidateEmail = source.candidateEmail || profile.email || '';\nconst candidatePhone = source.candidatePhone || profile.phone || '';\n\nconst scoreBreakdownText =\n  `Skills: ${clamp(a.skill_score)}% (weight 50%)\\n` +\n  `Experience: ${clamp(a.experience_score)}% (weight 25%)\\n` +\n  `Projects: ${clamp(a.project_score)}% (weight 15%)\\n` +\n  `Certifications: ${certScore === 'N/A' ? 'Not applicable (weight redistributed)' : certScore + '% (weight 10%)'}`;\n\nreturn [{\n  json: {\n    // ---- exact Google Sheet headers ----\n    'Application ID': applicationId,\n    'Candidate Name': candidateName,\n    'Job Title': source.jobTitle,\n    'Overall Match Score (%)': matchScore,\n    'Review Priority': reviewStatus,\n    'Recruiter Review Status': 'Pending',\n    'Email': candidateEmail,\n    'Phone': candidatePhone,\n    'Job ID': source.jobId,\n    'Submitted At': submittedAt,\n    'Skills Match (%)': clamp(a.skill_score),\n    'Experience Match (%)': clamp(a.experience_score),\n    'Projects Match (%)': clamp(a.project_score),\n    'Certifications Match (%)': certScore,\n    'Required Experience (Years)': source.requiredExperience,\n    'Candidate Experience (Years)': candidateYears,\n    'Candidate Skills': skills,\n    'Matching Skills': matching,\n    'Missing / Not Demonstrated Requirements': missing,\n    'Relevant Projects': a.project_evidence ?? '',\n    'AI Screening Summary': analysis.review_summary ?? '',\n    'Recruiter Notes': questions,\n    'Job Description': source.jobDescription,\n    'Resume File Name': resumeFileName,\n    'Candidate Notified': 'No',\n    'Decision Date': '',\n\n    // ---- helper fields for emails / IF ----\n    applicationId, candidateName, candidateEmail, candidatePhone,\n    jobId: source.jobId, jobTitle: source.jobTitle, requiredExperience: source.requiredExperience,\n    candidateExperienceYears: candidateYears,\n    matchScore, reviewStatus, skills,\n    matchingSkills: matching, missingOrUnverified: missing,\n    experienceSummary: profile.experience_summary ?? '',\n    experienceEvidence: a.experience_evidence ?? '',\n    projectEvidence: a.project_evidence ?? '',\n    certificationEvidence: a.certification_evidence ?? '',\n    reviewSummary: analysis.review_summary ?? '',\n    recruiterQuestions: questions,\n    resumeFileName, scoreBreakdownText,\n    rawAnalysis: JSON.stringify(analysis)\n  }\n}];"
      },
      "id": "effa93dc-1c89-4c3d-8999-b615223faf87",
      "name": "Parse Analysis and Calculate Score",
